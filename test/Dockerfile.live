# Imitates the Artix base dinit live ISO
FROM --platform=linux/amd64 artixlinux/artixlinux:latest

# basestrap copies this pacman.conf; the ISO has no NoExtract rules
RUN sed -i '/^NoExtract/d' /etc/pacman.conf \
 && pacman-key --init && pacman-key --populate artix \
 && pacman -Syu --noconfirm \
 && pacman -S --noconfirm --needed artools-base cryptsetup dosfstools e2fsprogs \
        util-linux curl kbd glibc which \
 && pacman -S --noconfirm glibc \
 && pacman -Scc --noconfirm

WORKDIR /work
