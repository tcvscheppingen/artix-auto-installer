#!/usr/bin/expect -f
# Boots the installed disk like a ThinkPad: UEFI with empty NVRAM (so the
# fallback BOOTX64.EFI is used), q35, NVMe, e1000e. TCG is slow, hence the timeouts.
set timeout 900
log_file -noappend /logs/boot.log

set luks "luks-test-passphrase"
set user "tester"
set pass "user pass 123"

exec cp /usr/share/OVMF/OVMF_VARS_4M.fd /tmp/vars.fd
spawn qemu-system-x86_64 -machine q35 -cpu max -smp 4 -m 4096 \
    -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd \
    -drive if=pflash,format=raw,file=/tmp/vars.fd \
    -drive file=/out/disk.img,if=none,id=nvm,format=raw \
    -device nvme,serial=T14S-NVME,drive=nvm \
    -netdev user,id=n0 -device e1000e,netdev=n0 \
    -nographic -no-reboot

proc fail {msg} { puts "\nBOOT TEST FAILED: $msg"; exit 1 }

expect {
    "Enter passphrase for" {}
    "unable to find root device" { fail "no root device (encrypt hook / cryptdevice)" }
    "Kernel panic" { fail "kernel panic" }
    timeout { fail "no passphrase prompt" }
}
puts "\n>>> TEST: passphrase prompt reached, typing passphrase"
sleep 1
send -- "$luks\r"

expect {
    -re "No key available|Device .* doesn't exist" { fail "LUKS unlock failed" }
    "login:" {}
    timeout { fail "no login prompt after unlock" }
}
puts "\n>>> TEST: login prompt reached"

set passed 0
set failed 0
proc check {ok name} {
    global passed failed
    if {$ok} { puts "\nPASS  $name"; incr passed } else { puts "\nFAIL  $name"; incr failed }
}

# --- Login, through getty + PAM ---
# A wrong password first, so a successful login proves it is checked
sleep 5
send -- "$user\r"
expect "Password:"
send -- "wrong password\r"
expect {
    "Login incorrect" { check 1 "login: wrong password is rejected" }
    -re {\]\$}        { check 0 "login: wrong password is rejected"; fail "logged in with a wrong password" }
    timeout           { check 0 "login: wrong password is rejected" }
}
expect "login:"
send -- "$user\r"
expect "Password:"
send -- "$pass\r"
expect {
    -re {\]\$}        { check 1 "login: $user logs in with the right password" }
    "Login incorrect" { check 0 "login: $user logs in with the right password"; fail "login failed" }
    timeout           { check 0 "login: $user logs in with the right password"; fail "no shell prompt" }
}
# A plain prompt is easier to match than Artix's colored one
send -- "PS1='READY> '\r"
expect "READY> "
send -- {echo "SESSION user=$(id -un) home=$HOME pwd=$(pwd) shell=$SHELL"}
send -- "\r"
expect {
    -re "SESSION user=$user home=/home/$user pwd=/home/$user shell=/bin/bash" {
        check 1 "login: session is $user, home /home/$user, shell bash"
    }
    -re {SESSION user=[a-z][^\r\n]*[\r\n]} { check 0 "login: session is $user, home /home/$user, shell bash" }
    timeout                   { check 0 "login: session is $user, home /home/$user, shell bash" }
}
expect "READY> "

# --- sudo (-k: always ask for the password) ---
send -- "sudo -k; sudo id -u\r"
expect "password for $user"
send -- "wrong password\r"
expect {
    "Sorry, try again" { check 1 "sudo: wrong password is rejected" }
    timeout            { check 0 "sudo: wrong password is rejected" }
}
send -- "\x03"
expect "READY> "
send -- {sudo -k; sudo sh -c 'echo "SUDO uid=$(id -u) user=$(id -un) by=$SUDO_USER"'}
send -- "\r"
expect "password for $user"
send -- "$pass\r"
expect {
    -re "SUDO uid=0 user=root by=$user" { check 1 "sudo: $user runs commands as root with own password" }
    -re {SUDO uid=[0-9][^\r\n]*[\r\n]}                 { check 0 "sudo: $user runs commands as root with own password" }
    "is not in the sudoers file"        { check 0 "sudo: $user runs commands as root with own password" }
    timeout                             { check 0 "sudo: $user runs commands as root with own password" }
}
expect "READY> "

# --- System checks as root ---
send -- "sudo -k; sudo /usr/local/bin/boot-checks.sh\r"
expect "password for $user"
send -- "$pass\r"
expect {
    -re {BOOT CHECKS: (\d+) passed, (\d+) failed} {
        incr passed $expect_out(1,string)
        incr failed $expect_out(2,string)
    }
    timeout { fail "boot checks did not finish" }
}
expect "READY> "
send -- "sudo poweroff\r"
expect {
    "password for" { send -- "$pass\r"; exp_continue }
    eof {}
    timeout {}
}
puts "\n== BOOT TEST TOTAL: $passed passed, $failed failed"
if {$failed != 0} { puts "BOOT TEST: $failed check(s) failed"; exit 1 }
puts "BOOT TEST PASSED"
