# Preset answers for artix-install.sh:  ./artix-install.sh --config install.conf
# Anything left empty or commented out is asked for interactively.
# Keep passwords out of this file unless you delete it afterwards.

#DISK=/dev/nvme0n1           # erased completely
#HOST_NAME=t14s
#USER_NAME=yourname
#USER_PASSWORD=
#LUKS_PASSWORD=
#ENABLE_ROOT=no              # yes = set a root password, no = lock root (use sudo)
#ROOT_PASSWORD=
#TIMEZONE=Europe/Amsterdam
#KEYMAP=us-acentos           # US international with dead keys; plain US = us
#LOCALE=en_US.UTF-8
#SWAP_SIZE=4                 # GiB, 0 = no swap file
#INSTALL_LTS=yes             # linux-lts as a fallback kernel
#INSTALL_TIMESHIFT=yes       # Timeshift snapshots + pacman hook
#ENABLE_AUR=no               # yes = build and install yay
#CONFIRM_WIPE=no             # yes = don't ask to type ERASE
#REBOOT_WHEN_DONE=           # yes/no, empty = ask

# Advanced (used by the automated tests)
#EXTRA_KERNEL_PARAMS=        # appended to GRUB_CMDLINE_LINUX
#LUKS_FORMAT_OPTS=           # extra options for cryptsetup luksFormat
#ALLOW_NO_UEFI=no            # testing only: run without UEFI firmware
#CPU_VENDOR=                # intel/amd, empty = detect from /proc/cpuinfo
#PACMAN_CHROOT_OPTS=         # extra pacman options in the chroot (containers: --disable-sandbox)
