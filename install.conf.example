# Preset answers for artix-install.sh:  ./artix-install.sh --config install.conf
# Anything left empty or commented out is asked for interactively.
# Keep passwords out of this file unless you delete it afterwards.
# The script runs this file as bash code, as root: only use a file you wrote
# yourself or have read.

#DISK=/dev/nvme0n1           # erased completely
#HOST_NAME=artix
#USER_NAME=yourname
#USER_PASSWORD=
#LUKS_PASSWORD=
#ENABLE_ROOT=no              # yes = set a root password, no = lock root (use sudo)
#ROOT_PASSWORD=
#TIMEZONE=Europe/Amsterdam
#KEYMAP=us-acentos           # US international with dead keys; plain US = us
#LOCALE=en_US.UTF-8
#SWAP_SIZE=4                 # GiB, 0 = no swap file
#INSTALL_LTS=yes             # linux-lts as a fallback kernel
#INSTALL_NVIDIA=             # yes/no, only asked when an NVIDIA GPU is found
#AUDIO_LEGACY_HDA=           # yes = older HDA sound driver instead of SOF (asked for Intel audio with a DSP)
#ENABLE_AUR=no               # yes = build and install yay
#DESKTOP=none                # none, plasma, cinnamon, xfce, lxqt, sway (SARBS) or dwm (DARBS)
#DESKTOP_LOGIN=dm            # sway/dwm only: tty (start on TTY1 login), dm (LightDM login screen) or none
#SWAY_WITHOUT_NVIDIA=        # sway with an NVIDIA GPU: yes = skip NVIDIA's driver (sway doesn't support it), empty = ask
#CONFIRM_WIPE=no             # yes = don't ask to type ERASE
#SAVE_SUMMARY=yes            # save the summary as ~/artix-install-summary.md
#REBOOT_WHEN_DONE=           # yes/no, empty = ask

# Advanced (used by the automated tests)
#EXTRA_KERNEL_PARAMS=        # appended to GRUB_CMDLINE_LINUX
#LUKS_FORMAT_OPTS=           # extra options for cryptsetup luksFormat
#ALLOW_NO_UEFI=no            # testing only: run without UEFI firmware
#CPU_VENDOR=                # intel/amd, empty = detect from /proc/cpuinfo
#NVIDIA_ID=                  # PCI device ID (e.g. 0x2560), empty = detect
#INTEL_AUDIO_DSP=no          # yes = act as if the Intel sound chip has a DSP
#PACMAN_CHROOT_OPTS=         # extra pacman options in the chroot (containers: --disable-sandbox)
#CRYPT_NAME=cryptroot        # name of the unlocked root, /dev/mapper/NAME
#TEST_IN_CONTAINER=no        # tests only: don't touch the host's EFI entries, clock or keymap
#SARBS_REPO=                 # git URL or local checkout of SARBS, empty = GitHub
#DARBS_REPO=                 # git URL or local checkout of DARBS, empty = GitHub
